# API de autenticación existente (backend Express)
AUTH_API_URL=http://127.0.0.1:3001

# Persistencia de producción para lives, usuarios y pedidos
DATABASE_URL=postgresql://xstore:cambia-esta-clave@localhost:5432/xstore?schema=public

# Redis para Socket.IO multi-instancia y rate limits
REDIS_URL=redis://:cambia-esta-clave@localhost:6379

# Secreto para firmar la cookie de sesión web
SESSION_SECRET=cambia-esto-en-produccion-por-un-seguro-de-32-caracteres

# Google OAuth (opcional hasta configurar una app OAuth en Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3200/api/auth/google/callback

# Realtime local; en producción apunta al servidor Socket.IO propio
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3001

# LiveKit (proveedor principal recomendado para live público)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVE_STALE_AFTER_MS=86400000

# WhatsApp/Yape (número de soporte, solo números con código de país)
WHATSAPP_SUPPORT_PHONE=51904918121
NEXT_PUBLIC_WHATSAPP_SUPPORT_PHONE=51904918121
PAYMENT_PROVIDER=WHATSAPP_ESCROW
ALLOW_DEMO_CATALOG=false

# WebRTC en redes públicas (fallback local; opcional)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
