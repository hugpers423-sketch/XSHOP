// prisma/schema.prisma
// X-STORE / OmniShop Engine — Esquema de base de datos completo
// Fusión TikTok (video) + Mercado Libre (transacciones) + Marketplace (geolocalización)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. USUARIOS Y ROLES
// ============================================================

enum Role {
  BUYER
  SELLER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String // hash de contraseña local; Google usa un valor aleatorio no utilizable
  externalId   String?    @unique
  googleSub    String?    @unique
  authProvider String     @default("PASSWORD")
  role         Role       @default(BUYER)
  status       UserStatus @default(ACTIVE)

  // Perfil social
  avatar     String?
  phone      String? @unique
  bio        String?
  reputation Float   @default(5.0) // 0.0 – 5.0 (estilo Mercado Libre)

  // Geolocalización (Marketplace hiper-local)
  latitude  Float?
  longitude Float?
  city      String?
  district  String?

  // Gamificación (X-Coins)
  xCoins Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relaciones ---
  products        Product[]
  ordersAsBuyer   Order[]           @relation("BuyerOrders")
  ordersAsSeller  Order[]           @relation("SellerOrders")
  chats           ChatParticipant[]
  sentMessages    Message[]
  videos          Video[]
  reviewsWritten  Review[]          @relation("Reviewer")
  reviewsReceived Review[]          @relation("Reviewee")
  wishlist        WishlistItem[]
  notifications   Notification[]
  transactions    Transaction[]
  liveStreams     LiveStream[]
  sessions        Session[]

  // Red social: a quién sigue y quién le sigue
  following       Follow[]        @relation("Follower")
  followers       Follow[]        @relation("Followed")
  videoLikes      VideoLike[]

  @@index([role, status])
  @@index([latitude, longitude]) // búsquedas por radio
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ============================================================
// 2. PRODUCTOS (Motor E-Commerce)
// ============================================================

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  slug     String     @unique
  icon     String?
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
}

model Product {
  id             String   @id @default(uuid())
  title          String
  description    String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // precio tachado
  stock          Int      @default(1)
  sku            String?  @unique

  // TikTok-style vertical video
  videoUrl  String?
  posterUrl String?

  // Marketplace geolocalizado
  location  String?
  latitude  Float?
  longitude Float?

  // Estado y métricas
  isActive Boolean @default(true)
  views    Int     @default(0)
  sales    Int     @default(0)
  rating   Float   @default(0)

  // Relaciones
  sellerId   String
  seller     User      @relation(fields: [sellerId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  orderItems OrderItem[]
  videos     Video[]
  wishlistBy WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([latitude, longitude]) // radio de búsqueda
  @@index([isActive, createdAt(sort: Desc)])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // "Talla M", "Color Rojo"
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  sku       String? @unique

  orderItems OrderItem[] // back-relation de OrderItem.variant

  @@index([productId])
}

// ============================================================
// 3. VIDEO / REELS (Feed vertical TikTok-style)
// ============================================================

model Video {
  id          String   @id @default(uuid())
  url         String
  posterUrl   String?
  caption     String
  hashtags    String[] // PostgreSQL array
  durationSec Int      @default(0)

  // Mux / streaming
  muxPlaybackId String?
  muxAssetId    String?

  // Autor
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Producto asociado (shoppable video)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Métricas de engagement
  views     Int @default(0)
  likes     Int @default(0)
  comments  Int @default(0)
  shares    Int @default(0)
  purchases Int @default(0)

  status    String   @default("PROCESSING") // PROCESSING, READY, FAILED
  createdAt DateTime @default(now())

  // Un like por usuario: permite saber QUIÉN gustó, no solo el contador.
  videoLikes VideoLike[]

  @@index([authorId])
  @@index([status, createdAt(sort: Desc)]) // feed principal
}

// Un usuario sigue a un vendedor. Personal de una tienda: al seguir al autor
// del video, se sigue al dueño del producto.
model Follow {
  id         String   @id @default(uuid())
  followerId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followedId String
  followed   User     @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followedId])
  @@index([followedId, createdAt(sort: Desc)]) // lista de seguidores del vendedor
  @@index([followerId, createdAt(sort: Desc)])
}

// Like por usuario sobre un video. El contador Video.likes sigue siendo la
// cifra pública; esta tabla guarda quién lo hizo, para no contar dos veces.
model VideoLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([videoId, createdAt(sort: Desc)])
}

// ============================================================
// 4. LIVE SHOPPING PERSISTENTE
// ============================================================

model LiveStream {
  id              String    @id @default(uuid())
  sellerId        String
  seller          User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  category        String    @default("General")
  productName     String?
  productPrice    Decimal?  @db.Decimal(10, 2)
  roomName        String?   @unique
  streamUrl       String?
  transport       String    @default("livekit") // hls | webrtc | livekit
  isLive          Boolean   @default(true)
  startedAt       DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isLive, startedAt(sort: Desc)])
  @@index([sellerId, isLive])
}

// ============================================================
// 5. TRANSACCIONES Y PEDIDOS (Mercado Libre-style)
// ============================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  YAPE
  PLIN
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique // ej. "XS-20260921-ABC123"
  status      OrderStatus @default(PENDING)

  // Montos
  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Envío
  shippingAddress String
  district        String?
  city            String?
  trackingNumber  String?
  carrier         String?
  notes           String?
  idempotencyKey  String?

  // Relaciones
  buyerId  String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])

  items         OrderItem[]
  transaction   Transaction?
  statusHistory OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  title    String
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @default(1)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Transaction {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?       @unique // comprobante Yape/Plin/transferencia
  proofImageUrl String? // captura de pago (escrow manual)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ============================================================
// 5. CHAT TIEMPO REAL (WhatsApp/Messenger-style)
// ============================================================

model Chat {
  id      String  @id @default(uuid())
  isGroup Boolean @default(false)
  name    String?

  // Contexto opcional: chat desde un producto o pedido
  // Scalar simple a propósito: sin relation para no acoplar Product <-> Chat
  productId String?

  participants ChatParticipant[]
  messages     Message[]

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([lastMessageAt(sort: Desc)])
}

model ChatParticipant {
  id       String   @id @default(uuid())
  chatId   String
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id       String @id @default(uuid())
  chatId   String
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  type    String @default("TEXT") // TEXT, IMAGE, PRODUCT, ORDER
  content String

  // Producto compartido en el chat (Marketplace)
  sharedProductId String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([senderId])
}

// ============================================================
// 6. RESEÑAS Y REPUTACIÓN
// ============================================================

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation("Reviewer", fields: [authorId], references: [id])
  sellerId  String
  seller    User    @relation("Reviewee", fields: [sellerId], references: [id])

  rating  Int // 1–5
  comment String?

  createdAt DateTime @default(now())

  @@unique([productId, authorId]) // 1 reseña por usuario por producto
  @@index([sellerId])
}

// ============================================================
// 7. WISHLIST Y NOTIFICACIONES
// ============================================================

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String // ORDER_SHIPPED, PRICE_DROP, CHAT_MESSAGE, LIVE_STARTED
  title  String
  body   String
  data   Json?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}
