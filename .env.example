# X-STORE — Variables de entorno (plantilla)
# Copiar a .env y completar valores reales

# ---------- Base de datos ----------
DATABASE_URL="postgresql://xstore:xstore_secret_change_me@localhost:5432/xstore?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://:xstore_redis_pass@localhost:6379"
REDIS_REQUIRED="false"

# ---------- HTTPS / Dominio ----------
XSHOP_DOMAIN=""
XSHOP_EMAIL=""
BACKEND_UPSTREAM="backend:3001"
WEB_UPSTREAM="web:3200"

# ---------- App ----------
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------- JWT ----------
JWT_SECRET="change-me-to-a-64-char-random-string"
JWT_REFRESH_SECRET="change-me-another-64-char-random"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------- WhatsApp Escrow ----------
WHATSAPP_SUPPORT_PHONE="51904918121"
WHATSAPP_PARTNER_PHONE="51900000000"
LIVE_STALE_AFTER_MS="86400000"

# ---------- Almacenamiento (MinIO/S3) ----------
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="xstore-media"
S3_ACCESS_KEY="xstore_minio"
S3_SECRET_KEY="xstore_minio_secret"

# ---------- Mux (video streaming) ----------
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# ---------- Typesense (búsqueda) ----------
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_API_KEY="xstore_ts_key_change_me"

# ---------- Notificaciones push ----------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
