<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptativo de X-STORE.
  Capa 1 de 2: este degradado + el primer plano (ic_launcher_foreground.png,
  generado por tools/generate-app-icons.ps1).
  El launcher recorta ambas capas con su propia mascara (circulo, squircle...),
  por eso aqui va un rectango completo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF2D75"
        android:centerColor="#7B5CFF"
        android:endColor="#05060A"
        android:type="linear" />
</shape>
